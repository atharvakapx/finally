# Optional: OpenAI API key for LLM chat functionality
# If absent or empty, the backend uses deterministic mock responses
OPENAI_API_KEY=

# Optional: Massive (Polygon.io) API key for real market data
# If not set, the built-in market simulator is used
MASSIVE_API_KEY=

# Optional: Force deterministic mock LLM responses even when OPENAI_API_KEY is set
LLM_MOCK=false
