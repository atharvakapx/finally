# FinAlly environment variables
# Copy to .env and fill in your keys

# Optional: OpenAI API key for LLM chat
# If absent, mock responses are used automatically
OPENAI_API_KEY=

# Optional: Massive (Polygon.io) API key for real market data
# If absent, the built-in simulator is used
MASSIVE_API_KEY=

# Optional: Force mock LLM responses even when OPENAI_API_KEY is set
# Set to true for testing and CI
LLM_MOCK=false
